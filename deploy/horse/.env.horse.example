# Immutable application image produced by the Horse CI.
BRIGHTBEAN_IMAGE=ghcr.io/marcelosaltori/brightbean-studio:<full-git-sha>
BRIGHTBEAN_HOST=brightbean.example.com
BRIGHTBEAN_SECRETS_DIR=/opt/brightbean/secrets

TRAEFIK_NETWORK=coolify
TRAEFIK_ENTRYPOINT=https
TRAEFIK_CERTRESOLVER=letsencrypt

POSTGRES_DB=brightbean
POSTGRES_USER=brightbean

ALLOWED_HOSTS=brightbean.example.com
APP_URL=https://brightbean.example.com
CSRF_TRUSTED_ORIGINS=https://brightbean.example.com

# Production media is intentionally external to the VPS filesystem.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
S3_BUCKET_NAME=brightbean-staging
S3_CUSTOM_DOMAIN=media-brightbean.example.com
S3_REGION_NAME=auto

SENTRY_DSN=
